# ~/.config/waker/agent.yaml — on the desktop
listen: auto            # bind primary tailnet IP :8091
token: CHANGE_ME        # same token as server.yaml
start_timeout: 30s
health_interval: 30s

lmstudio:
  port: 1234

services:
  - id: lm-daemon
    name: LM Studio Daemon
    start: ["/home/medidew/.lmstudio/bin/lms", "daemon", "up"]
    stop:  ["/home/medidew/.lmstudio/bin/lms", "daemon", "down"]
    # lms exits 0 whether or not the daemon is up, so probe its JSON output
    # ("status":"running" plus a live PID) instead of the exit code.
    status_json: ["/home/medidew/.lmstudio/bin/lms", "daemon", "status", "--json"]

  - id: lm-server
    name: LM Studio Server
    start: ["/home/medidew/.lmstudio/bin/lms", "server", "start", "--bind", "0.0.0.0"]
    stop:  ["/home/medidew/.lmstudio/bin/lms", "server", "stop"]
    status: ["/home/medidew/.lmstudio/bin/lms", "server", "status"]
    health: http://127.0.0.1:1234/health

  # System-wide unit: the agent runs as a user service, so system units need
  # sudo — add a narrow NOPASSWD rule in /etc/sudoers.d/waker for exactly
  # these commands (validate with `sudo visudo -cf`).
  - id: openwebui
    name: Open WebUI
    start: ["sudo", "systemctl", "start", "open-webui.service"]
    stop:  ["sudo", "systemctl", "stop", "open-webui.service"]
    status: ["sudo", "systemctl", "is-active", "open-webui.service"]
    health: http://127.0.0.1:8080/

  # User unit: systemctl --user works directly (the agent shares the user).
  - id: comfyui
    name: ComfyUI
    start: ["systemctl", "--user", "start", "comfyui.service"]
    stop:  ["systemctl", "--user", "stop", "comfyui.service"]
    status: ["systemctl", "--user", "is-active", "comfyui.service"]
    health: http://127.0.0.1:8188/
