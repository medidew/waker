# /etc/waker/server.yaml — on the always-on box
listen: auto            # bind primary tailnet IP :8090 (or e.g. "127.0.0.1:8090" + tailscale serve)
token: CHANGE_ME        # openssl rand -hex 16

desktop:
  mac: "AA:BB:CC:DD:EE:FF"   # TODO: desktop NIC MAC (ip link on the desktop)
  hostname: medidewpc       # tailnet node name of the desktop (`tailscale status`)
  ssh_user: medidew

wake:
  target: "192.168.1.255:9"  # LAN broadcast address
  count: 5
  interval_ms: 1000

agent_port: 8091
presence_interval: 5s   # tailscale presence check cadence AND dashboard refresh period

# Named reverse targets behind /u/<id>/ — service UIs served from the
# wakeserver origin, so the browser only ever talks to waker.
# "desktop:<port>" chases the desktop's current tailnet IP; anything else
# is used verbatim. Waker's own cookie/Authorization are never forwarded.
proxies:
  - { id: lmstudio,  target: "desktop:1234" }
  - { id: openwebui, target: "https://openwebui.taild83b61.ts.net" }
  - { id: comfyui,   target: "https://comfyui.taild83b61.ts.net" }

links:
  - { name: "LM Studio", proxy: lmstudio, service: lm-server }
  # A link can bind to a managed desktop service (by id from agent.yaml):
  # the row then shows a live status dot.
  - { name: "Open WebUI", proxy: openwebui, service: openwebui }
  - { name: "ComfyUI", proxy: comfyui, service: comfyui }
