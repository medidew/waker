# User unit: run with `systemctl --user enable waker-agent` on the desktop.
# A user service so the lms CLI operates on the right LM Studio profile ($HOME).

[Unit]
Description=Waker desktop agent
After=network-online.target

[Service]
ExecStart=%h/.local/bin/wakeragent -config %h/.config/waker/agent.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
